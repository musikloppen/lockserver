FROM perl-base:latest

LABEL maintainer="Kristoffer Ek <stoffer@skulp.net>"

# Install Redis server (spejle er allerede fikset i perl-base)
RUN apt-get update && apt-get install -y --no-install-recommends \
    redis-server \
    && rm -rf /var/lib/apt/lists/*

# Expose Redis port
EXPOSE 6379

# Run Redis bound to all interfaces and turn off protected mode so containers can talk to it
CMD ["redis-server", "--protected-mode", "no", "--bind", "0.0.0.0", "--save", ""]